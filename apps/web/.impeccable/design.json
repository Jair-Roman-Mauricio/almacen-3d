      "kind": "custom",
      "description": "Lectura estática del inventario con unidad por valor.",
      "html": "<table class=\"ds-quantities\"><caption class=\"ds-table-caption\">Inventario por producto</caption><thead><tr><th scope=\"col\">Físico</th><th scope=\"col\">Reservado</th><th scope=\"col\">Disponible</th></tr></thead><tbody><tr><td data-label=\"Físico\">12,500<span> kg</span></td><td data-label=\"Reservado\">2,000<span> kg</span></td><td data-label=\"Disponible\" class=\"ds-available\">10,500<span> kg</span></td></tr></tbody></table>",
      "css": ".ds-quantities{width:100%;border-collapse:collapse;background:var(--surface);color:var(--ink);font-family:var(--font-ui);font-size:14px;}.ds-table-caption{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}.ds-quantities th{text-align:right;font-weight:600;font-size:12px;color:var(--muted);background:var(--rail);padding:13px 12px;border-bottom:1px solid var(--line);}.ds-quantities td{text-align:right;padding:17px 12px;border-bottom:1px solid #edf0f5;font-variant-numeric:tabular-nums;font-weight:600;overflow-wrap:anywhere;}.ds-quantities .ds-available{font-weight:750;}.ds-quantities span{font-size:11px;font-weight:400;color:var(--muted);}@media(max-width:680px){.ds-quantities thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);}.ds-quantities,.ds-quantities tbody{display:block;}.ds-quantities tr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px 12px;padding:20px 16px;border-bottom:1px solid var(--line);}.ds-quantities td{padding:0;border:0;text-align:left;font-size:15px;min-width:0;}.ds-quantities td::before{content:attr(data-label);display:block;margin-bottom:5px;color:var(--muted);font-size:12px;font-weight:500;}.ds-quantities span{display:block;margin-top:3px;}}"
