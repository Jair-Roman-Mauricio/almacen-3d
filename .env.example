# Ejecuta node scripts/setup-env.mjs para generar .env sin exponer contraseñas.
PG_DEV_BOOTSTRAP_PASSWORD=
PG_DEV_MIGRATION_PASSWORD=
PG_DEV_APP_PASSWORD=
PG_DEV_PROVISION_PASSWORD=
PG_TEST_BOOTSTRAP_PASSWORD=
PG_TEST_MIGRATION_PASSWORD=
PG_TEST_APP_PASSWORD=
PG_TEST_PROVISION_PASSWORD=
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_PROVISION_URL=
TEST_DATABASE_URL=
TEST_MIGRATION_URL=
TEST_PROVISION_URL=

# Modalidad de una instalación nueva y origen exacto del cliente local.
INSTALLATION_MODE=saas
APP_ORIGIN=http://127.0.0.1:3000
DEMO_MODE=false

# Límite técnico de transporte JSON; no es una cuota de elementos de almacén.
API_JSON_LIMIT=16mb

# Proxy de Next: dirección fija de la API, solo en servidor (sin NEXT_PUBLIC).
API_UPSTREAM_URL=http://127.0.0.1:3001
